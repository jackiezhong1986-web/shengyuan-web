---
import Layout from '../layouts/Layout.astro';
import FlowSchematic from './FlowSchematic.astro';
import { t, type Locale } from '../i18n/ui';
import { localePath } from '../i18n/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<Layout locale={locale} title={copy.meta.homeTitle} description={copy.meta.homeDesc}>
  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker">{copy.hero.kicker}</p>
          <h1 class="hero-mark">{copy.hero.title}</h1>
          <hr class="rule" />
          <div class="chips">
            {copy.hero.chips.map((chip) => <span class="chip">{chip}</span>)}
          </div>
          <p class="sub">{copy.hero.sub}</p>
          <p class="body">{copy.hero.body}</p>
          <a class="btn" href={localePath(locale, 'contact')}>{copy.cta}</a>
        </div>
        <FlowSchematic id={copy.schematic.id} title={copy.schematic.title} steps={copy.schematic.steps} />
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{copy.about.id}</p>
          <h2>{copy.about.title}</h2>
        </div>
        <div class="grid-about">
          {copy.about.items.map((item) => (
            <article class="card">
              <p class="mod-id">{item.kicker}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{copy.cards.id}</p>
          <h2>{copy.cards.title}</h2>
        </div>
        <div class="grid-cards">
          {copy.cards.items.map((card) => (
            <a class:list={['card', { featured: card.featured }]} href={localePath(locale, 'capabilities')}>
              {card.featured && <span class="badge">{copy.cards.featured}</span>}
              <p class="mod-id">{card.id}</p>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{copy.audience.id}</p>
          <h2>{copy.audience.title}</h2>
        </div>
        <div class="grid-3">
          {copy.audience.items.map((item) => (
            <article class="card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
