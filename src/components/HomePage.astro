---
import Layout from '../layouts/Layout.astro';
import { t, type Locale } from '../i18n/ui';
import { localePath } from '../i18n/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<Layout locale={locale} title={copy.meta.homeTitle} description={copy.meta.homeDesc}>
  <main>
    <section class="hero">
      <div class="wrap">
        <p class="kicker">{copy.hero.kicker}</p>
        <h1>{copy.hero.title}</h1>
        <hr class="rule" />
        <p class="sub">{copy.hero.sub}</p>
        <p class="body">{copy.hero.body}</p>
        <a class="btn" href={localePath(locale, 'contact')}>{copy.cta}</a>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2>{copy.cards.title}</h2>
        <div class="grid-3">
          {copy.cards.items.map((card) => (
            <a class:list={['card', { featured: card.featured }]} href={localePath(locale, 'capabilities')}>
              {card.featured && <span class="badge">{copy.cards.featured}</span>}
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>{copy.audience.title}</h2>
        <div class="grid-3">
          {copy.audience.items.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .band h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }
  .band p {
    margin: 0;
    color: var(--muted);
  }
</style>
