---
import Layout from '../layouts/Layout.astro';
import FlowSchematic from './FlowSchematic.astro';
import { t, type Locale } from '../i18n/ui';
import { localePath } from '../i18n/paths';

interface Props {
  locale: Locale;
  kind: 'capabilities' | 'scenarios' | 'delivery' | 'contact';
}

const { locale, kind } = Astro.props;
const copy = t(locale);
const titleMap = {
  capabilities: copy.meta.capabilitiesTitle,
  scenarios: copy.meta.scenariosTitle,
  delivery: copy.meta.deliveryTitle,
  contact: copy.meta.contactTitle,
};
const descMap = {
  capabilities: copy.meta.capabilitiesDesc,
  scenarios: copy.meta.scenariosDesc,
  delivery: copy.meta.deliveryDesc,
  contact: copy.meta.contactDesc,
};
const idMap = {
  capabilities: copy.capabilities.id,
  scenarios: copy.scenarios.id,
  delivery: copy.delivery.id,
  contact: 'CNT-01',
};
---

<Layout locale={locale} title={titleMap[kind]} description={descMap[kind]}>
  <main>
    <div class="page-head">
      <div class="wrap">
        <p class="kicker">{idMap[kind]}</p>
        <h1>{titleMap[kind]}</h1>
        <hr class="rule" />
        {kind === 'capabilities' && <p class="lede">{copy.capabilities.intro}</p>}
        {kind === 'scenarios' && <p class="lede">{copy.scenarios.intro}</p>}
        {kind === 'delivery' && <p class="lede">{copy.delivery.intro}</p>}
        {kind === 'contact' && <p class="lede">{copy.contact.intro}</p>}
      </div>
    </div>

    <section class="section">
      <div class="wrap">
        {kind === 'capabilities' && (
          <div class="stack">
            {copy.capabilities.items.map((item) => (
              <article class:list={['card', { featured: item.featured }]}>
                {item.featured && <span class="badge">{copy.cards.featured}</span>}
                <p class="mod-id">{item.id}</p>
                <h2>{item.title}</h2>
                <p>{item.body}</p>
                <table class="spec-table">
                  <thead>
                    <tr>
                      <th>ID</th>
                      <th>SPEC</th>
                    </tr>
                  </thead>
                  <tbody>
                    {item.rows.map((row) => (
                      <tr>
                        <td>{row.label}</td>
                        <td>{row.detail}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {item.modules && (
                  <table class="spec-table">
                    <thead>
                      <tr>
                        <th>MODULE</th>
                        <th>SCOPE</th>
                      </tr>
                    </thead>
                    <tbody>
                      {item.modules.map((mod) => (
                        <tr>
                          <td>{mod.name}</td>
                          <td>{mod.scope}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
                {item.featured && (
                  <div style="margin-top:1.1rem">
                    <FlowSchematic
                      id={copy.schematic.id}
                      title={item.flow ?? copy.schematic.title}
                      steps={copy.schematic.steps}
                    />
                  </div>
                )}
                {item.note && <p class="note" style="margin-top:0.9rem">{item.note}</p>}
              </article>
            ))}
          </div>
        )}

        {kind === 'scenarios' && (
          <div class="stack">
            {copy.scenarios.items.map((item, i) => (
              <article class="card">
                <p class="mod-id">{String(i + 1).padStart(2, '0')}</p>
                <h2>{item.title}</h2>
                <p>{item.body}</p>
                <ul class="points">
                  {item.points.map((p) => <li>{p}</li>)}
                </ul>
              </article>
            ))}
          </div>
        )}

        {kind === 'delivery' && (
          <div class="stack">
            {copy.delivery.items.map((item, i) => (
              <article class="card">
                <p class="mod-id">{String(i + 1).padStart(2, '0')}</p>
                <h2>{item.title}</h2>
                <p>{item.body}</p>
              </article>
            ))}
            <p class="lede">{copy.delivery.note}</p>
            <p><a class="btn" href={localePath(locale, 'contact')}>{copy.cta}</a></p>
          </div>
        )}

        {kind === 'contact' && (
          <div class="contact-box">
            <dl>
              <dt>{copy.contact.company}</dt>
              <dd>{copy.brand}</dd>
              <dt>{copy.contact.personLabel}</dt>
              <dd>{copy.person}</dd>
              <dt>{copy.contact.mailLabel}</dt>
              <dd>
                <a href={`mailto:${copy.email}`}>{copy.email}</a>
              </dd>
            </dl>
            <p style="margin-top:1.2rem">
              <a class="btn" href={`mailto:${copy.email}`}>{copy.cta}</a>
            </p>
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>
